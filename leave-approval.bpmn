<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" id="Definitions_LeaveApproval" targetNamespace="http://xyz.example/leave" exporter="Camunda Modeler" exporterVersion="5.49.0">
  <bpmn:process id="LeaveApprovalProcess" name="Employee Leave Request Approval" isExecutable="true">
    <bpmn:startEvent id="StartEvent" name="Leave Request Submitted">
      <bpmn:outgoing>Flow_Start_Submit</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="SubmitLeave" name="Submit Leave Request">
      <bpmn:incoming>Flow_Start_Submit</bpmn:incoming>
      <bpmn:outgoing>Flow_Submit_Check</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="CheckBalance" name="Check Leave Balance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="check-leave-balance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Submit_Check</bpmn:incoming>
      <bpmn:outgoing>Flow_Check_Gateway</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="BalanceGateway" name="Balance sufficient?">
      <bpmn:incoming>Flow_Check_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Balance_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Balance_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="NotifyInsufficient" name="Notify Employee - Insufficient Balance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-employee" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Balance_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Insufficient_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndInsufficient" name="Rejected - Insufficient Balance">
      <bpmn:incoming>Flow_Insufficient_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:businessRuleTask id="EvaluateLeave" name="Evaluate Leave Request (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="LeaveApprovalDecision" resultVariable="approvalDecision" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Balance_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_Decision_Gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:exclusiveGateway id="ApprovalGateway" name="Approval decision?">
      <bpmn:incoming>Flow_Decision_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto</bpmn:outgoing>
      <bpmn:outgoing>Flow_Manager</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="AutoApprove" name="Auto Approve">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="auto-approve-leave" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Auto</bpmn:incoming>
      <bpmn:outgoing>Flow_Auto_HR</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="ManagerApproval" name="Manager Approval">
      <bpmn:incoming>Flow_Manager</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager_Gateway</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="ManagerGateway" name="Manager approved?">
      <bpmn:incoming>Flow_Manager_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Manager_No</bpmn:outgoing>
      <bpmn:outgoing>Flow_Manager_Yes</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="NotifyRejected" name="Notify Employee - Rejected">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-employee" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Manager_No</bpmn:incoming>
      <bpmn:outgoing>Flow_Rejected_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndRejected" name="Rejected">
      <bpmn:incoming>Flow_Rejected_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:serviceTask id="ForwardHR" name="Forward to HR">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="forward-to-hr" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Auto_HR</bpmn:incoming>
      <bpmn:incoming>Flow_Manager_Yes</bpmn:incoming>
      <bpmn:outgoing>Flow_HR_Update</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="UpdateBalance" name="Update Leave Balance">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="update-leave-balance" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_HR_Update</bpmn:incoming>
      <bpmn:outgoing>Flow_Update_Notify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="NotifyApproved" name="Notify Employee - Approved">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="notify-employee" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Update_Notify</bpmn:incoming>
      <bpmn:outgoing>Flow_Approved_End</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndApproved" name="Approved">
      <bpmn:incoming>Flow_Approved_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Start_Submit" sourceRef="StartEvent" targetRef="SubmitLeave" />
    <bpmn:sequenceFlow id="Flow_Submit_Check" sourceRef="SubmitLeave" targetRef="CheckBalance" />
    <bpmn:sequenceFlow id="Flow_Check_Gateway" sourceRef="CheckBalance" targetRef="BalanceGateway" />
    <bpmn:sequenceFlow id="Flow_Balance_No" name="No" sourceRef="BalanceGateway" targetRef="NotifyInsufficient">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= availableBalance &lt; requestedDays</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Balance_Yes" name="Yes" sourceRef="BalanceGateway" targetRef="EvaluateLeave">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= availableBalance &gt;= requestedDays</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Insufficient_End" sourceRef="NotifyInsufficient" targetRef="EndInsufficient" />
    <bpmn:sequenceFlow id="Flow_Decision_Gateway" sourceRef="EvaluateLeave" targetRef="ApprovalGateway" />
    <bpmn:sequenceFlow id="Flow_Auto" name="AUTO_APPROVE" sourceRef="ApprovalGateway" targetRef="AutoApprove">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= approvalDecision = "AUTO_APPROVE"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Manager" name="MANAGER_APPROVAL" sourceRef="ApprovalGateway" targetRef="ManagerApproval">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= approvalDecision = "MANAGER_APPROVAL"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Auto_HR" sourceRef="AutoApprove" targetRef="ForwardHR" />
    <bpmn:sequenceFlow id="Flow_Manager_Gateway" sourceRef="ManagerApproval" targetRef="ManagerGateway" />
    <bpmn:sequenceFlow id="Flow_Manager_No" name="Rejected" sourceRef="ManagerGateway" targetRef="NotifyRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= managerDecision = "REJECTED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Manager_Yes" name="Approved" sourceRef="ManagerGateway" targetRef="ForwardHR">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">= managerDecision = "APPROVED"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Rejected_End" sourceRef="NotifyRejected" targetRef="EndRejected" />
    <bpmn:sequenceFlow id="Flow_HR_Update" sourceRef="ForwardHR" targetRef="UpdateBalance" />
    <bpmn:sequenceFlow id="Flow_Update_Notify" sourceRef="UpdateBalance" targetRef="NotifyApproved" />
    <bpmn:sequenceFlow id="Flow_Approved_End" sourceRef="NotifyApproved" targetRef="EndApproved" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_LeaveApproval">
    <bpmndi:BPMNPlane id="BPMNPlane_LeaveApproval" bpmnElement="LeaveApprovalProcess">
      <bpmndi:BPMNShape id="StartEvent_di" bpmnElement="StartEvent">
        <dc:Bounds x="170" y="240" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="151" y="276" width="74" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubmitLeave_di" bpmnElement="SubmitLeave">
        <dc:Bounds x="240" y="218" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="CheckBalance_di" bpmnElement="CheckBalance">
        <dc:Bounds x="400" y="218" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="BalanceGateway_di" bpmnElement="BalanceGateway" isMarkerVisible="true">
        <dc:Bounds x="560" y="233" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="560" y="283" width="50" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyInsufficient_di" bpmnElement="NotifyInsufficient">
        <dc:Bounds x="520" y="360" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndInsufficient_di" bpmnElement="EndInsufficient">
        <dc:Bounds x="720" y="382" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="699" y="418" width="79" height="40" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EvaluateLeave_di" bpmnElement="EvaluateLeave">
        <dc:Bounds x="650" y="218" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ApprovalGateway_di" bpmnElement="ApprovalGateway" isMarkerVisible="true">
        <dc:Bounds x="830" y="233" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="832" y="283" width="47" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="AutoApprove_di" bpmnElement="AutoApprove">
        <dc:Bounds x="910" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ManagerApproval_di" bpmnElement="ManagerApproval">
        <dc:Bounds x="910" y="300" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ManagerGateway_di" bpmnElement="ManagerGateway" isMarkerVisible="true">
        <dc:Bounds x="1090" y="315" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1089" y="365" width="52" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyRejected_di" bpmnElement="NotifyRejected">
        <dc:Bounds x="1170" y="400" width="150" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndRejected_di" bpmnElement="EndRejected">
        <dc:Bounds x="1360" y="422" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1356" y="458" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="ForwardHR_di" bpmnElement="ForwardHR">
        <dc:Bounds x="1110" y="120" width="120" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="UpdateBalance_di" bpmnElement="UpdateBalance">
        <dc:Bounds x="1280" y="120" width="140" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="NotifyApproved_di" bpmnElement="NotifyApproved">
        <dc:Bounds x="1470" y="120" width="160" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="EndApproved_di" bpmnElement="EndApproved">
        <dc:Bounds x="1680" y="142" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1674" y="178" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_Submit_di" bpmnElement="Flow_Start_Submit">
        <di:waypoint x="206" y="258" />
        <di:waypoint x="240" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Submit_Check_di" bpmnElement="Flow_Submit_Check">
        <di:waypoint x="360" y="258" />
        <di:waypoint x="400" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Check_Gateway_di" bpmnElement="Flow_Check_Gateway">
        <di:waypoint x="520" y="258" />
        <di:waypoint x="560" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Balance_No_di" bpmnElement="Flow_Balance_No">
        <di:waypoint x="585" y="283" />
        <di:waypoint x="585" y="360" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="593" y="312" width="15" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Balance_Yes_di" bpmnElement="Flow_Balance_Yes">
        <di:waypoint x="610" y="258" />
        <di:waypoint x="650" y="258" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="621" y="233" width="18" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Insufficient_End_di" bpmnElement="Flow_Insufficient_End">
        <di:waypoint x="670" y="400" />
        <di:waypoint x="720" y="400" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Decision_Gateway_di" bpmnElement="Flow_Decision_Gateway">
        <di:waypoint x="790" y="258" />
        <di:waypoint x="830" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Auto_di" bpmnElement="Flow_Auto">
        <di:waypoint x="855" y="233" />
        <di:waypoint x="855" y="160" />
        <di:waypoint x="910" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="825" y="187" width="90" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_di" bpmnElement="Flow_Manager">
        <di:waypoint x="880" y="258" />
        <di:waypoint x="880" y="340" />
        <di:waypoint x="910" y="340" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="828" y="346" width="84" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Auto_HR_di" bpmnElement="Flow_Auto_HR">
        <di:waypoint x="1030" y="160" />
        <di:waypoint x="1110" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_Gateway_di" bpmnElement="Flow_Manager_Gateway">
        <di:waypoint x="1050" y="340" />
        <di:waypoint x="1090" y="340" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_No_di" bpmnElement="Flow_Manager_No">
        <di:waypoint x="1115" y="365" />
        <di:waypoint x="1115" y="440" />
        <di:waypoint x="1170" y="440" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1108" y="393" width="44" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Manager_Yes_di" bpmnElement="Flow_Manager_Yes">
        <di:waypoint x="1115" y="315" />
        <di:waypoint x="1115" y="160" />
        <di:waypoint x="1110" y="160" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1106" y="228" width="48" height="14" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Rejected_End_di" bpmnElement="Flow_Rejected_End">
        <di:waypoint x="1320" y="440" />
        <di:waypoint x="1360" y="440" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_HR_Update_di" bpmnElement="Flow_HR_Update">
        <di:waypoint x="1230" y="160" />
        <di:waypoint x="1280" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Update_Notify_di" bpmnElement="Flow_Update_Notify">
        <di:waypoint x="1420" y="160" />
        <di:waypoint x="1470" y="160" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Approved_End_di" bpmnElement="Flow_Approved_End">
        <di:waypoint x="1630" y="160" />
        <di:waypoint x="1680" y="160" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
